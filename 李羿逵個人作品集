        function getCategoryBadgeStyle(category) {
            switch(category) {
                case '量化與財金':
                    return 'bg-sky-500/15 text-sky-300 border-sky-500/30';
                case '創新企劃':
                    return 'bg-purple-500/15 text-purple-300 border-purple-500/30';
                case '跨域與實務':
                    return 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30';
                default:
                    return 'bg-slate-800 text-slate-300 border-slate-700';
            }
        }
 
        // 渲染 15 項作品卡片
        function renderPortfolioGrid() {
            const grid = document.getElementById('portfolio-grid');
            const filtered = portfolioData.filter(item => {
                const matchCat = currentFilter === 'ALL' || item.category === currentFilter;
                const q = searchQuery.trim().toLowerCase();
                const matchSearch = !q || 
                    item.title.toLowerCase().includes(q) ||
                    item.bg.toLowerCase().includes(q) ||
                    item.method.toLowerCase().includes(q) ||
                    item.outcome.toLowerCase().includes(q) ||
                    item.tags.some(t => t.toLowerCase().includes(q));
                return matchCat && matchSearch;
            });
 
            document.getElementById('visible-count').textContent = filtered.length;
 
            grid.innerHTML = filtered.map(item => {
                const badgeClass = getCategoryBadgeStyle(item.category);
                const visualHtml = item.customImg 
                    ? `<img src="${item.customImg}" alt="${item.title}" class="w-full h-full object-cover">`
                    : getCustomSvgVisual(item.visualType);
 
                const realFileBadge = item.hasRealFile 
                    ? `<span class="px-2 py-0.5 rounded bg-amber-500/20 border border-amber-400/40 text-amber-300 text-[10px] font-bold"><i class="fa-solid fa-star mr-1"></i>含真實檔案預覽</span>`
                    : ``;
 
                return `
                    <article class="glass-card glass-card-hover rounded-2xl overflow-hidden flex flex-col justify-between group">
                        <div>
                            <div class="relative aspect-[16/9] bg-slate-950 border-b border-slate-800/80 overflow-hidden">
                                <div onclick="openModal('${item.id}')" class="w-full h-full cursor-pointer">
                                    ${visualHtml}
                                </div>
                                
                                <div class="absolute top-3 left-3 flex flex-wrap items-center gap-1.5 pointer-events-none">
                                    <span class="px-2.5 py-1 rounded-lg bg-slate-950/90 border border-slate-700 text-sky-400 font-mono font-black text-xs shadow">
                                        #${item.id}
                                    </span>
                                    <span class="px-2.5 py-1 rounded-lg border text-[11px] font-medium backdrop-blur-md ${badgeClass}">
                                        ${item.category}
                                    </span>
                                    ${realFileBadge}
                                </div>
 
                                <button 
                                    onclick="triggerItemPhotoUpload('${item.id}', event)" 
                                    class="no-print absolute top-3 right-3 px-2.5 py-1 rounded-lg bg-slate-950/85 hover:bg-sky-500 text-slate-200 hover:text-slate-950 border border-slate-700 text-[11px] font-semibold transition flex items-center gap-1"
                                    title="更換此作品相片"
                                >
                                    <i class="fa-solid fa-camera"></i> 更換作品相片
                                </button>
                            </div>
 
                            <div onclick="openModal('${item.id}')" class="p-5 cursor-pointer">
                                <div class="flex items-center justify-between text-[11px] font-mono text-slate-400 mb-1.5">
                                    <span>PORTFOLIO ITEM #${item.id}</span>
                                    <span>${item.date}</span>
                                </div>
 
                                <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-sky-300 transition leading-snug mb-3">
                                    ${item.title}
                                </h3>
 
                                <div class="space-y-2 text-xs text-slate-300 leading-relaxed">
                                    <p class="line-clamp-2">
                                        <strong class="text-sky-400">【執行方法】</strong>${item.method}
                                    </p>
                                    <p class="line-clamp-2">
                                        <strong class="text-emerald-400">【具體成果】</strong>${item.outcome}
                                    </p>
                                </div>
                            </div>
                        </div>
 
                        <div class="px-5 pb-4 pt-3 border-t border-slate-800/80 flex items-center justify-between gap-2">
                            <div class="flex flex-wrap gap-1.5 overflow-hidden max-h-6">
                                ${item.tags.slice(0, 3).map(tag => `
                                    <span class="px-2 py-0.5 rounded bg-slate-800/90 text-slate-300 text-[11px]">#${tag}</span>
                                `).join('')}
                            </div>
                            <button onclick="openModal('${item.id}')" class="text-xs font-bold text-sky-400 hover:text-sky-300 whitespace-nowrap flex items-center gap-1">
                                詳情與編輯 <i class="fa-solid fa-arrow-right text-[10px]"></i>
                            </button>
                        </div>
                    </article>
                `;
            }).join('');
        }
 
        function filterCategory(category) {
            currentFilter = category;
            document.querySelectorAll('.cat-btn').forEach(btn => {
                if (btn.dataset.cat === category) {
                    btn.className = "cat-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition bg-sky-500 text-slate-950 shadow-md shadow-sky-500/20";
                } else {
                    btn.className = "cat-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-medium transition glass-card text-slate-300 hover:text-white";
                }
            });
            renderPortfolioGrid();
        }
 
        function handleSearch(val) {
            searchQuery = val;
            renderPortfolioGrid();
        }
 
        // 正裝照上傳與顯示
        function triggerSuitPhotoUpload() {
            document.getElementById('suit-photo-input').click();
        }
 
        function handleSuitPhotoChange(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                const dataUrl = e.target.result;
                applySuitPhoto(dataUrl);
                try {
                    localStorage.setItem('yikui_u1334049_suit_v2', dataUrl);
                } catch(err) {}
                showToast("已成功更新你的個人面試正裝照！");
            };
            reader.readAsDataURL(file);
        }
 
        function applySuitPhoto(dataUrl) {
            const img = document.getElementById('suit-photo-img');
            const placeholder = document.getElementById('suit-photo-placeholder');
            img.src = dataUrl;
            img.classList.remove('hidden');
            placeholder.classList.add('hidden');
        }
 
        // 作品相片上傳與顯示
        function triggerItemPhotoUpload(itemId, event) {
            if (event) event.stopPropagation();
            currentPhotoUploadItemId = itemId;
            document.getElementById('item-photo-input').click();
        }
 
        function triggerCurrentModalPhotoUpload() {
            if (!currentModalItemId) return;
            currentPhotoUploadItemId = currentModalItemId;
            document.getElementById('item-photo-input').click();
        }
 
        function handleItemPhotoChange(event) {
            const file = event.target.files[0];
            if (!file || !currentPhotoUploadItemId) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                const dataUrl = e.target.result;
                const item = portfolioData.find(i => i.id === currentPhotoUploadItemId);
                if (item) {
                    item.customImg = dataUrl;
                    saveDataToStorage();
                    renderPortfolioGrid();
                    if (currentModalItemId === currentPhotoUploadItemId) {
                        openModal(currentModalItemId);
                    }
                    showToast(`已成功更新作品 #${currentPhotoUploadItemId} 的相片！`);
                }
            };
            reader.readAsDataURL(file);
        }
 
        // 彈窗開啟與內容編輯
        function openModal(itemId) {
            const item = portfolioData.find(i => i.id === itemId);
            if (!item) return;
            currentModalItemId = itemId;
 
            document.getElementById('modal-id-badge').textContent = `#${item.id}`;
            document.getElementById('modal-category-badge').textContent = item.category;
            document.getElementById('modal-date').textContent = item.date;
            document.getElementById('modal-title').textContent = item.title;
            document.getElementById('modal-bg').textContent = item.bg;
            document.getElementById('modal-method').textContent = item.method;
            document.getElementById('modal-outcome').textContent = item.outcome;
 
            const visualContainer = document.getElementById('modal-visual-container');
            visualContainer.innerHTML = item.customImg 
                ? `<img src="${item.customImg}" alt="${item.title}" class="w-full h-full object-contain bg-slate-950">`
                : getCustomSvgVisual(item.visualType);
 
            // 若為 #01, #02, #03 顯示真實檔案預覽區塊
            const attachmentBox = document.getElementById('modal-attachment-box');
            const attachmentHtml = getRealAttachmentHtml(item.id);
            if (attachmentHtml) {
                attachmentBox.innerHTML = attachmentHtml;
                attachmentBox.classList.remove('hidden');
            } else {
                attachmentBox.innerHTML = '';
                attachmentBox.classList.add('hidden');
            }
 
            document.getElementById('modal-tags').innerHTML = item.tags.map(t => `
                <span class="px-3 py-1 rounded-full bg-slate-800 border border-slate-700 text-sky-300 text-xs">#${t}</span>
            `).join('');
 
            document.getElementById('edit-title').value = item.title;
            document.getElementById('edit-bg').value = item.bg;
            document.getElementById('edit-method').value = item.method;
            document.getElementById('edit-outcome').value = item.outcome;
 
            document.getElementById('modal-edit-section').classList.add('hidden');
            document.getElementById('modal-save-btn').classList.add('hidden');
 
            const modal = document.getElementById('detail-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }
 
        function closeModal() {
            const modal = document.getElementById('detail-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            currentModalItemId = null;
        }
 
        function toggleModalEditForm() {
            document.getElementById('modal-edit-section').classList.toggle('hidden');
            document.getElementById('modal-save-btn').classList.toggle('hidden');
        }
 
        function saveModalChanges() {
            if (!currentModalItemId) return;
            const item = portfolioData.find(i => i.id === currentModalItemId);
            if (!item) return;
 
            item.title = document.getElementById('edit-title').value.trim() || item.title;
            item.bg = document.getElementById('edit-bg').value.trim() || item.bg;
            item.method = document.getElementById('edit-method').value.trim() || item.method;
            item.outcome = document.getElementById('edit-outcome').value.trim() || item.outcome;
 
            saveDataToStorage();
            renderPortfolioGrid();
            openModal(currentModalItemId);
            showToast(`作品 #${item.id} 修改已儲存！`);
        }
 
        // 匯出包含最新修改與上傳圖片之獨立單頁 HTML 檔案
        function exportStandaloneHTML() {
            const clonedDoc = document.documentElement.cloneNode(true);
            const scripts = clonedDoc.querySelectorAll('script');
            const lastScript = scripts[scripts.length - 1];
            if (lastScript) {
                lastScript.textContent = lastScript.textContent.replace(
                    /const defaultPortfolioItems = \[[\s\S]*?\];/,
                    `const defaultPortfolioItems = ${JSON.stringify(portfolioData, null, 4)};`
                );
            }
            const htmlContent = "<!DOCTYPE html>\n" + clonedDoc.outerHTML;
            const blob = new Blob([htmlContent], { type: "text/html;charset=utf-8" });
            const url = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url;
            a.download = "U1334049_李羿逵_個人作品集與15項履歷資料庫.html";
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            showToast("已成功匯出獨立 HTML 檔案！");
        }
 
        function resetAllData() {
            localStorage.removeItem('yikui_u1334049_portfolio_v2');
            localStorage.removeItem('yikui_u1334049_suit_v2');
            portfolioData = JSON.parse(JSON.stringify(defaultPortfolioItems));
            document.getElementById('suit-photo-img').classList.add('hidden');
            document.getElementById('suit-photo-placeholder').classList.remove('hidden');
            renderPortfolioGrid();
            showToast("已重置為預設的 15 項完整作品資料！");
        }
 
        function showToast(message) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').textContent = message;
            toast.classList.remove('hidden');
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 3200);
        }
 
        document.getElementById('detail-modal').addEventListener('click', function(e) {
            if (e.target === this) closeModal();
        });
    </script>
